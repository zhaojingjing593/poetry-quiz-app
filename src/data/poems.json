[
  {
    "id": 1,
    "title": "约客",
    "author": "赵师秀",
    "couplets": [
      ["黄梅时节家家雨，", "青草池塘处处蛙。"],
      ["有约不来过夜半，", "闲敲棋子落灯花。"]
    ],
    "note": "八年级上册"
  },
  {
    "id": 2,
    "title": "龟虽寿",
    "author": "曹操",
    "couplets": [
      ["神龟虽寿，", "犹有竟时。"],
      ["腾蛇乘雾，", "终为土灰。"],
      ["老骥伏枥，", "志在千里。"],
      ["烈士暮年，", "壮心不已。"],
      ["盈缩之期，", "不但在天。"],
      ["养怡之福，", "可得永年。"],
      ["幸甚至哉，", "歌以咏志。"]
    ],
    "note": "八年级上册"
  },
  {
    "id": 3,
    "title": "野望",
    "author": "王绩",
    "couplets": [
      ["东皋薄暮望，", "徙倚欲何依。"],
      ["树树皆秋色，", "山山唯落晖。"],
      ["牧人驱犊返，", "猎马带禽归。"],
      ["相顾无相识，", "长歌怀采薇。"]
    ],
    "note": "八年级上册"
  },
  {
    "id": 4,
    "title": "黄鹤楼",
    "author": "崔颢",
    "couplets": [
      ["昔人已乘黄鹤去，", "此地空余黄鹤楼。"],
      ["黄鹤一去不复返，", "白云千载空悠悠。"],
      ["晴川历历汉阳树，", "芳草萋萋鹦鹉洲。"],
      ["日暮乡关何处是？", "烟波江上使人愁。"]
    ],
    "note": "八年级上册"
  },
  {
    "id": 5,
    "title": "使至塞上",
    "author": "王维",
    "couplets": [
      ["单车欲问边，", "属国过居延。"],
      ["征蓬出汉塞，", "归雁入胡天。"],
      ["大漠孤烟直，", "长河落日圆。"],
      ["萧关逢候骑，", "都护在燕然。"]
    ],
    "note": "八年级上册"
  },
  {
    "id": 6,
    "title": "渡荆门送别",
    "author": "李白",
    "couplets": [
      ["渡远荆门外，", "来从楚国游。"],
      ["山随平野尽，", "江入大荒流。"],
      ["月下飞天镜，", "云生结海楼。"],
      ["仍怜故乡水，", "万里送行舟。"]
    ],
    "note": "八年级上册"
  },
  {
    "id": 7,
    "title": "钱塘湖春行",
    "author": "白居易",
    "couplets": [
      ["孤山寺北贾亭西，", "水面初平云脚低。"],
      ["几处早莺争暖树，", "谁家新燕啄春泥。"],
      ["乱花渐欲迷人眼，", "浅草才能没马蹄。"],
      ["最爱湖东行不足，", "绿杨阴里白沙堤。"]
    ],
    "note": "八年级上册"
  },
  {
    "id": 8,
    "title": "庭中有奇树",
    "author": "无名氏",
    "couplets": [
      ["庭中有奇树，", "绿叶发华滋。"],
      ["攀条折其荣，", "将以遗所思。"],
      ["馨香盈怀袖，", "路远莫致之。"],
      ["此物何足贵？", "但感别经时。"]
    ],
    "note": "八年级上册·《古诗十九首》"
  },
  {
    "id": 9,
    "title": "赠从弟（其二）",
    "author": "刘桢",
    "couplets": [
      ["亭亭山上松，", "瑟瑟谷中风。"],
      ["风声一何盛，", "松枝一何劲！"],
      ["冰霜正惨凄，", "终岁常端正。"],
      ["岂不罹凝寒？", "松柏有本性。"]
    ],
    "note": "八年级上册"
  },
  {
    "id": 10,
    "title": "梁甫行",
    "author": "曹植",
    "couplets": [
      ["八方各异气，", "千里殊风雨。"],
      ["剧哉边海民，", "寄身于草野。"],
      ["妻子象禽兽，", "行止依林阻。"],
      ["柴门何萧条，", "狐兔翔我宇。"]
    ],
    "note": "八年级上册"
  },
  {
    "id": 11,
    "title": "饮酒（其五）",
    "author": "陶渊明",
    "couplets": [
      ["结庐在人境，", "而无车马喧。"],
      ["问君何能尔？", "心远地自偏。"],
      ["采菊东篱下，", "悠然见南山。"],
      ["山气日夕佳，", "飞鸟相与还。"],
      ["此中有真意，", "欲辨已忘言。"]
    ],
    "note": "八年级上册"
  },
  {
    "id": 12,
    "title": "春望",
    "author": "杜甫",
    "couplets": [
      ["国破山河在，", "城春草木深。"],
      ["感时花溅泪，", "恨别鸟惊心。"],
      ["烽火连三月，", "家书抵万金。"],
      ["白头搔更短，", "浑欲不胜簪。"]
    ],
    "note": "八年级上册"
  },
  {
    "id": 13,
    "title": "雁门太守行",
    "author": "李贺",
    "couplets": [
      ["黑云压城城欲摧，", "甲光向日金鳞开。"],
      ["角声满天秋色里，", "塞上燕脂凝夜紫。"],
      ["半卷红旗临易水，", "霜重鼓寒声不起。"],
      ["报君黄金台上意，", "提携玉龙为君死。"]
    ],
    "note": "八年级上册"
  }
]
